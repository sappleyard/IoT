{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/autocommit.sh",
            "async": true,
            "timeout": 60
          }
        ]
      }
    ]
  }
}
