[Unit]
Description=Aircraft-Noise step 3: talk to the bridge ESP32 over USB serial
After=network.target

[Service]
User=@USER@
WorkingDirectory=@PI_DIR@
# Waits quietly for the bridge to be plugged in, and reconnects if it's unplugged.
ExecStart=/usr/bin/python3 -m aircraft_noise.nodes.link
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
