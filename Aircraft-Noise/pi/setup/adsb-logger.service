[Unit]
Description=Aircraft-Noise: log ADS-B aircraft positions
After=readsb.service
Wants=readsb.service

[Service]
User=@USER@
WorkingDirectory=@PI_DIR@
ExecStart=/usr/bin/python3 -m aircraft_noise.adsb_logger
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
