# Original ESP32: the console goes through the board's USB-UART chip (CP2102) on UART0.
# 921600 baud carries the raw audio stream (~43 KB/s); the default 115200 can't.
# The baud rate only takes effect with a "custom" console, hence the first line.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_TX_GPIO=1
CONFIG_ESP_CONSOLE_UART_RX_GPIO=3
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# These dev boards have 4 MB of Boya flash (esptool and the boot log both report it).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
