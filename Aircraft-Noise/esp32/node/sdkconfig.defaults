# Settings for every target and both nodes. Per-node settings are in sdkconfig.node_a/_b,
# target-specific ones in sdkconfig.defaults.<target>.

# Keep log output down to warnings.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# Original ESP32 (USB-UART chip): fast enough for the raw audio stream when recording.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
