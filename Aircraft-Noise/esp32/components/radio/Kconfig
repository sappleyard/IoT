menu "ESP-NOW radio"

    config RADIO_CHANNEL
        int "Wi-Fi channel (must be the same on all three boards)"
        range 1 13
        default 1

    config RADIO_LONG_RANGE
        bool "Long-range mode (must be the same on all three boards)"
        default n
        help
            Espressif's long-range (LR) mode: lower data rate, much better range through
            walls. Turn this on for all three boards if the far rooms drop packets.

endmenu
