menu "INMP441 microphone"

    config MIC_PIN_SCK
        int "SCK (bit clock) GPIO"
        default 4 if IDF_TARGET_ESP32S3
        default 26

    config MIC_PIN_WS
        int "WS (word select) GPIO"
        default 5 if IDF_TARGET_ESP32S3
        default 25

    config MIC_PIN_SD
        int "SD (data) GPIO"
        default 6 if IDF_TARGET_ESP32S3
        default 33

    config MIC_AUDIO_GAIN_DB
        int "Digital gain for the raw 16-bit audio stream (dB)"
        range 0 36
        default 18
        help
            Applied only to audio streamed to the Pi/laptop, not to the reported levels.
            18 dB puts quiet rooms well above the 16-bit noise floor and only clips
            above roughly 100 dB SPL.

endmenu
